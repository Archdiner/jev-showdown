# Pokemon Showdown credentials (required for ladder play)
SHOWDOWN_USERNAME=YourBotUsername
SHOWDOWN_PASSWORD=YourPassword

# Vercel AI Gateway (optional). Never log this value.
# Jev advises during search; the loss reviewer defaults to spacexai/grok-4.7.
VERCEL_AI_GATEWAY_KEY=your_key_here
# LOSS_REVIEWER_MODEL=spacexai/grok-4.7
# Accepted alias:
# AI_GATEWAY_API_KEY=your_key_here

# Optional PostHog mirror of finished ladder games. Off when unset.
# JSONL under logs/ladder/ stays the source of truth. The sink is async.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_LLM_TRACES=1
