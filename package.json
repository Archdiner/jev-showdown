{
  "name": "jev-showdown",
  "version": "0.1.0",
  "description": "Self-improving Pokemon Showdown Gen 9 Random Battle bot",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "verify": "bash scripts/verify.sh",
    "graph": "tsx src/graph/cli.ts",
    "gate": "tsx src/graph/gate-cli.ts",
    "regressions": "tsx src/graph/regressions-cli.ts",
    "data:refresh": "tsx src/data/refresh-data.ts",
    "selfplay": "tsx src/cli/selfplay.ts",
    "ladder": "tsx src/cli/ladder.ts",
    "foe-prior:compare": "tsx src/engine/foe-prior-compare.ts",
    "replays:download": "tsx src/cli/download-replays.ts",
    "analyze": "tsx src/cli/analyze-losses.ts",
    "llm:smoke": "tsx src/llm/smoke.ts",
    "llm:review": "tsx src/llm/review-cli.ts",
    "exp": "tsx src/exp/cli.ts",
    "ops": "tsx src/ops/cli.ts",
    "benchmark": "tsx src/cli/benchmark.ts",
    "export-replays": "tsx src/cli/export-replays.ts",
    "eval:sets": "tsx src/cli/eval-sets.ts",
    "lint": "eslint src/**/*.ts",
    "dashboard": "tsx src/dashboard/cli.ts",
    "calibration": "tsx src/cli/calibration.ts"
  },
  "keywords": [
    "pokemon",
    "showdown",
    "ai",
    "mcts"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@pkmn/client": "^0.7.3",
    "@pkmn/data": "^0.10.11",
    "@pkmn/dex": "^0.10.11",
    "@pkmn/protocol": "^0.7.3",
    "@pkmn/randoms": "^0.10.11",
    "@pkmn/sim": "^0.10.11",
    "@smogon/calc": "^0.12.0",
    "better-sqlite3": "^13.0.3",
    "ws": "^8.18.0",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "eslint": "^9.14.0",
    "jest": "^29.7.0",
    "pokemon-showdown": "^0.11.11",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
